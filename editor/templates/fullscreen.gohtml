{{/* go-wiki fullscreen split-view overlay */}}
<div id="gw-fullscreen-editor" class="gw-fullscreen-editor gw-hidden">
  <div class="gw-fullscreen-topbar">
    <div class="gw-fullscreen-title">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      <span id="gw-fullscreen-post-title">Editing</span>
    </div>
    <div class="gw-fullscreen-controls">
      <label class="gw-fullscreen-opt">
        <input type="checkbox" id="gw-fullscreen-preview-full" checked /> Show full content
      </label>
      <button type="button" id="gw-fullscreen-exit" class="gw-btn-fullscreen-exit" title="Exit fullscreen (Esc)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"/>
        </svg>
        Exit
      </button>
    </div>
  </div>
  <div class="gw-fullscreen-split">
    <div class="gw-fullscreen-pane gw-fullscreen-pane-editor">
      <div class="gw-pane-header">
        <span class="gw-pane-label">Markdown</span>
        <span class="gw-pane-hint">Raw editor</span>
      </div>
      <textarea id="gw-fullscreen-textarea" class="gw-fullscreen-textarea" spellcheck="true"></textarea>
    </div>
    <div class="gw-fullscreen-divider" id="gw-fullscreen-divider"></div>
    <div class="gw-fullscreen-pane gw-fullscreen-pane-preview">
      <div class="gw-pane-header">
        <span class="gw-pane-label">Preview</span>
        <span class="gw-pane-hint" id="gw-fullscreen-preview-status">Live</span>
      </div>
      <div id="gw-fullscreen-preview-content" class="gw-fullscreen-preview-content"></div>
    </div>
  </div>
</div>
