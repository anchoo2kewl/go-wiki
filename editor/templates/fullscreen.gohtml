{{/* go-wiki fullscreen split-view overlay */}}
<div id="gw-fullscreen-editor" class="gw-fullscreen-editor gw-hidden">
  <div class="gw-fullscreen-topbar">
    <div class="gw-fullscreen-title">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      <span id="gw-fullscreen-post-title">Editing</span>
    </div>
    <div class="gw-fullscreen-toolbar">
      <button type="button" class="gw-fs-btn" data-fs="bold" title="Bold"><b>B</b></button>
      <button type="button" class="gw-fs-btn" data-fs="italic" title="Italic"><i>I</i></button>
      <span class="gw-fs-sep"></span>
      <button type="button" class="gw-fs-btn" data-fs="h2" title="Heading 2">H2</button>
      <button type="button" class="gw-fs-btn" data-fs="h3" title="Heading 3">H3</button>
      <span class="gw-fs-sep"></span>
      <button type="button" class="gw-fs-btn" data-fs="ul" title="Bullet list">&bull;</button>
      <button type="button" class="gw-fs-btn" data-fs="ol" title="Numbered list">1.</button>
      <button type="button" class="gw-fs-btn" data-fs="quote" title="Blockquote">&ldquo;</button>
      <button type="button" class="gw-fs-btn" data-fs="hr" title="Horizontal rule">&mdash;</button>
      <button type="button" class="gw-fs-btn" data-fs="code" title="Inline code">&lt;&gt;</button>
      <button type="button" class="gw-fs-btn" data-fs="link" title="Link">&#128279;</button>
      {{if .ImageListEndpoint}}
      <span class="gw-fs-sep"></span>
      <button type="button" class="gw-fs-btn" data-fs="images" title="Browse images">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      </button>
      {{end}}
      {{if .EnableMore}}
      <button type="button" class="gw-fs-btn" data-fs="more" title="Insert read-more marker">More</button>
      {{end}}
      {{if .DrawBasePath}}
      <span class="gw-fs-sep"></span>
      <button type="button" class="gw-fs-btn" data-fs="draw" title="Insert drawing">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
      </button>
      {{end}}
    </div>
    <div class="gw-fullscreen-controls">
      <label class="gw-fullscreen-opt">
        <input type="checkbox" id="gw-fullscreen-preview-full" checked /> Show full content
      </label>
      <button type="button" id="gw-fullscreen-exit" class="gw-btn-fullscreen-exit" title="Exit fullscreen (Esc)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"/>
        </svg>
        Exit
      </button>
    </div>
  </div>
  <div class="gw-fullscreen-split">
    <div class="gw-fullscreen-pane gw-fullscreen-pane-editor">
      <div class="gw-pane-header">
        <span class="gw-pane-label">Markdown</span>
        <span class="gw-pane-hint">Raw editor</span>
      </div>
      <div class="gw-fullscreen-textarea-wrap">
        <textarea id="gw-fullscreen-textarea" class="gw-fullscreen-textarea" spellcheck="true"></textarea>
      </div>
      {{if .UploadEndpoint}}
      <div class="gw-upload-zone gw-fs-upload-zone" id="gw-fs-upload-zone">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
        <span>Drop images here or click to upload</span>
        <input type="file" id="gw-fs-upload-input" multiple accept="image/*" style="display:none" />
      </div>
      {{end}}
    </div>
    <div class="gw-fullscreen-divider" id="gw-fullscreen-divider"></div>
    <div class="gw-fullscreen-pane gw-fullscreen-pane-preview">
      <div class="gw-pane-header">
        <span class="gw-pane-label">Preview</span>
        <span class="gw-pane-hint" id="gw-fullscreen-preview-status">Live</span>
      </div>
      <div id="gw-fullscreen-preview-content" class="gw-fullscreen-preview-content"></div>
    </div>
  </div>
</div>
