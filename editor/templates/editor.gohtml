{{/* go-wiki editor toolbar + textarea + edit/preview tabs */}}
<div class="gw-editor-toolbar">
  <div class="gw-btn-group">
    <button type="button" class="gw-btn" id="gw-undo" title="Undo (Cmd/Ctrl+Z)">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
    </button>
    <button type="button" class="gw-btn" id="gw-redo" title="Redo (Cmd/Ctrl+Shift+Z)">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
    </button>
    <span class="gw-sep"></span>
    <button type="button" class="gw-btn" id="gw-bold"><b>B</b></button>
    <button type="button" class="gw-btn" id="gw-italic"><i>I</i></button>
    <span class="gw-sep"></span>
    <button type="button" class="gw-btn" id="gw-h2">H2</button>
    <button type="button" class="gw-btn" id="gw-h3">H3</button>
    <span class="gw-sep"></span>
    <button type="button" class="gw-btn" id="gw-ul">&bull; List</button>
    <button type="button" class="gw-btn" id="gw-ol">1. List</button>
    <button type="button" class="gw-btn" id="gw-blockquote">&ldquo; Quote</button>
    <button type="button" class="gw-btn" id="gw-hr">HR</button>
    <button type="button" class="gw-btn" id="gw-code">Code</button>
    <span class="gw-sep"></span>
    <button type="button" class="gw-btn" id="gw-link">Link</button>
    {{if .ImageListEndpoint}}
    <button type="button" class="gw-btn" id="gw-images" title="Browse uploaded images">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:2px"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      Images
    </button>
    {{end}}
    {{if .EnableMore}}
    <button type="button" class="gw-btn" id="gw-more" title="Insert read-more marker">More</button>
    {{end}}
    {{if .DrawBasePath}}
    <span class="gw-sep"></span>
    <button type="button" class="gw-btn" id="gw-draw" title="Insert a drawing canvas">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:2px"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
      Draw
    </button>
    {{end}}
  </div>

  <div class="gw-segmented">
    <button type="button" id="gw-tab-edit" class="gw-seg-btn active">Edit</button>
    <button type="button" id="gw-tab-preview" class="gw-seg-btn">Preview</button>
    <label class="gw-seg-opt">
      <input type="checkbox" id="gw-preview-full" checked /> Full
    </label>
  </div>

  {{if .EnableFullscreen}}
  <button type="button" id="gw-fullscreen-btn" class="gw-btn-fullscreen" title="Fullscreen split view (F11)">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
    </svg>
    Fullscreen
  </button>
  {{end}}
</div>

<div class="gw-editor-textarea-wrap" id="gw-editor-textarea-wrap">
  <textarea id="{{.TextareaID}}" name="{{.TextareaName}}" class="gw-form-input" style="min-height: 400px; font-family: ui-monospace, SFMono-Regular, Consolas, Monaco, monospace; font-size: 14px; line-height: 1.5; resize: vertical;">{{.InitialContent}}</textarea>
</div>
{{if .UploadEndpoint}}
<div class="gw-upload-zone" id="gw-upload-zone">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
  <span>Drop images here or click to upload</span>
  <input type="file" id="gw-upload-input" multiple accept="image/*" style="display:none" />
</div>
{{end}}

<div id="gw-preview" class="gw-preview gw-hidden">
  <div id="gw-preview-content" class="gw-preview-content"></div>
</div>

<!-- Image browser modal (rendered by JS) -->
<div id="gw-image-modal" class="gw-modal gw-hidden">
  <div class="gw-modal-backdrop"></div>
  <div class="gw-modal-content">
    <div class="gw-modal-header">
      <span>Images</span>
      <button type="button" class="gw-modal-close" id="gw-image-modal-close">&times;</button>
    </div>
    <div class="gw-modal-body" id="gw-image-modal-body">
      <div class="gw-image-grid" id="gw-image-grid"></div>
    </div>
  </div>
</div>
